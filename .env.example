# .env.example — template for environment variables
# Copy to backend/.env (and apps/mobile/.env if needed) and fill in real values.
# NEVER commit real .env files. NEVER put SERVER-ONLY secrets into the Flutter app.

# ---------- Supabase (client-safe: anon key only) ----------
# Used by the Flutter app and by FastAPI for user-token verification.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# JWKS endpoint (derived; shown for clarity) — FastAPI validates JWTs here:
# https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json

# ---------- Supabase (SERVER ONLY — never in Flutter, never in Git) ----------
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# ---------- FastAPI ----------
APP_ENV=development            # development | staging | production
APP_NAME=my-application-api
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO

# JWT verification strictness (Supabase issuer/audience)
JWT_ISSUER=https://YOUR-PROJECT-REF.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
JWKS_CACHE_SECONDS=3600

# ---------- OAuth (SERVER ONLY where secrets are involved) ----------
GOOGLE_CLIENT_ID=your-google-client-id
# Google client secret: SERVER ONLY
GOOGLE_CLIENT_SECRET=server-only-google-client-secret
APPLE_CLIENT_ID=your.apple.services.id
# Apple client secret / key: SERVER ONLY
APPLE_CLIENT_SECRET=server-only-apple-client-secret
APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id

# ---------- Optional monitoring (evaluate privacy before enabling) ----------
SENTRY_DSN=
POSTHOG_API_KEY=               # requires approval before integration
